---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
---

<Header />
<main>
    <section class="hero">
        <h1>Gallery</h1>
        <p>Explore our photo gallery from past events and adventures.</p>
    </section>
    <h3>2025</h3>
    <div class="gallery-item">
      <details class="gallery-details">
        <summary class="expand-link">
          <img src="/fonts/icons/expand-more.svg" alt="" width="16" height="16" />
          <span>Conservation Weekend</span>
        </summary>
        <div class="gallery-preview">
          <img src="/images/gallery/cons-weekend_2026/fatherson.jpg" alt="Conservation Weekend 2026" />
          <img src="/images/gallery/cons-weekend_2026/eagle.jpg" alt="Conservation Weekend 2026" />
          <img src="/images/gallery/cons-weekend_2026/1.jpg" alt="Conservation Weekend 2026" />
          <img src="/images/gallery/cons-weekend_2026/2.jpg" alt="Conservation Weekend 2026" />
        </div>
      </details>
    </div>
    <h3>2026</h3>
    <div class="gallery-item">
      <details class="gallery-details">
        <summary class="expand-link">
          <img src="/fonts/icons/expand-more.svg" alt="" width="16" height="16" />
          <span>Summer Camp</span>
        </summary>
        <div class="gallery-preview">
          <video src="/images/gallery/summer-camp_2026/summer-camp.mp4" controls width="600" height="400"></video>
        </div>
      </details>
    </div>
    <div class="gallery-item">
      <details class="gallery-details">
        <summary class="expand-link">
          <img src="/fonts/icons/expand-more.svg" alt="" width="16" height="16" />
          <span>Tubing/Kayaking - Appalachian Outfitters</span>
        </summary>
        <div class="gallery-preview">
          <img src="/images/gallery/cons-weekend_2026/fatherson.jpg" alt="Conservation Weekend 2026" />
          <img src="/images/gallery/cons-weekend_2026/eagle.jpg" alt="Conservation Weekend 2026" />
          <img src="/images/gallery/cons-weekend_2026/1.jpg" alt="Conservation Weekend 2026" />
          <img src="/images/gallery/cons-weekend_2026/2.jpg" alt="Conservation Weekend 2026" />
        </div>
      </details>
    </div>
</main>
<Footer />
